{
  "entities": {
    "Agent": {
      "title": "Agent",
      "description": "Agent representing an autonomous entity.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "codeName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 100 },
        "department": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "modelTier": { "type": "string", "maxLength": 50 },
        "riskClassification": { "type": "string", "maxLength": 50 },
        "permissionLevel": { "type": "string", "maxLength": 50 },
        "capabilityProfile": { "type": "string", "maxLength": 500 },
        "tasksCompleted": { "type": "number" },
        "uptime": { "type": "string", "maxLength": 50 },
        "lastActive": { "type": "string", "maxLength": 50 },
        "currentTask": { "type": "string", "maxLength": 500 },
        "avatarSeed": { "type": "string", "maxLength": 100 },
        "ownerId": { "type": "string", "maxLength": 128 }
      },
      "required": ["name", "codeName", "ownerId"]
    },
    "Client": {
      "title": "Client",
      "description": "Enterprise clients in the system.",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "maxLength": 150 },
        "industry": { "type": "string", "maxLength": 100 },
        "accountEmail": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 },
        "headquarters": { "type": "string", "maxLength": 200 },
        "contractValue": { "type": "string", "maxLength": 100 },
        "onboardingDate": { "type": "string", "maxLength": 50 },
        "assignedAgent": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 1000 },
        "activeJobsCount": { "type": "number" },
        "ownerId": { "type": "string", "maxLength": 128 }
      },
      "required": ["companyName", "ownerId"]
    },
    "EmployeeMessage": {
      "title": "EmployeeMessage",
      "description": "Direct message or department channel communication between employees.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderRole": { "type": "string", "maxLength": 100 },
        "senderDepartment": { "type": "string", "maxLength": 100 },
        "recipientId": { "type": "string", "maxLength": 128 },
        "recipientType": { "type": "string", "maxLength": 50 },
        "recipientName": { "type": "string", "maxLength": 100 },
        "content": { "type": "string", "maxLength": 5000 },
        "timestamp": { "type": "string", "maxLength": 100 },
        "ownerId": { "type": "string", "maxLength": 128 }
      },
      "required": ["senderId", "senderName", "recipientId", "content", "ownerId"]
    },
    "EmployeeDocument": {
      "title": "EmployeeDocument",
      "description": "Paperwork, files, or documents sent for review and approval.",
      "type": "object",
      "properties": {
        "documentTitle": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "targetDepartment": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "fileName": { "type": "string", "maxLength": 200 },
        "fileSize": { "type": "string", "maxLength": 50 },
        "submissionDate": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 1000 },
        "reviewerFeedback": { "type": "string", "maxLength": 1000 },
        "ownerId": { "type": "string", "maxLength": 128 }
      },
      "required": ["documentTitle", "senderId", "senderName", "targetDepartment", "status", "ownerId"]
    },
    "Job": {
      "title": "Job",
      "description": "User tasks and deliverable jobs.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "clientName": { "type": "string", "maxLength": 150 },
        "assignedAgent": { "type": "string", "maxLength": 100 },
        "priority": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 },
        "dueDate": { "type": "string", "maxLength": 50 },
        "summary": { "type": "string", "maxLength": 1000 },
        "ownerId": { "type": "string", "maxLength": 128 }
      },
      "required": ["title", "ownerId"]
    },
    "Call": {
      "title": "Call",
      "description": "Telephony call logs, recordings, and AI-assisted receptionist records.",
      "type": "object",
      "properties": {
        "callerName": { "type": "string", "maxLength": 150 },
        "company": { "type": "string", "maxLength": 150 },
        "phoneNumber": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "string", "maxLength": 100 },
        "duration": { "type": "string", "maxLength": 50 },
        "sentiment": { "type": "string", "maxLength": 50 },
        "summary": { "type": "string", "maxLength": 2000 },
        "agentRoutedTo": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "answeredBy": { "type": "string", "maxLength": 50 },
        "ownerId": { "type": "string", "maxLength": 128 }
      },
      "required": ["phoneNumber", "ownerId"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "description": "User profile records."
    },
    "calls/{callId}": {
      "schema": { "$ref": "#/entities/Call" },
      "description": "Collection of incoming and outbound telephone call records."
    },
    "jobs/{jobId}": {
      "schema": { "$ref": "#/entities/Job" },
      "description": "User tasks and jobs."
    },
    "agents/{agentId}": {
      "schema": { "$ref": "#/entities/Agent" },
      "description": "Collection of autonomous agents."
    },
    "clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Collection of clients."
    },
    "employee_messages/{messageId}": {
      "schema": { "$ref": "#/entities/EmployeeMessage" },
      "description": "Collection of employee direct and department messages."
    },
    "employee_documents/{documentId}": {
      "schema": { "$ref": "#/entities/EmployeeDocument" },
      "description": "Collection of employee paperwork and documents for approval."
    }
  }
}
