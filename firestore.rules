rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidAgent(data) {
      return data.keys().hasAll(['name', 'codeName', 'ownerId']) &&
             data.name is string && data.name.size() <= 100 &&
             data.codeName is string && data.codeName.size() <= 100 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.ownerId == request.auth.uid;
    }

    match /agents/{agentId} {
      allow read, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(agentId) && isValidAgent(incoming());
      allow update: if isSignedIn() && isValidId(agentId) && existing().ownerId == request.auth.uid && incoming().ownerId == request.auth.uid && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'currentTask', 'tasksCompleted', 'lastActive'])
      );
      allow delete: if isSignedIn() && isValidId(agentId) && existing().ownerId == request.auth.uid;
    }

    function isValidClient(data) {
      return data.keys().hasAll(['companyName', 'ownerId']) &&
             data.companyName is string && data.companyName.size() <= 150 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.ownerId == request.auth.uid;
    }

    match /clients/{clientId} {
      allow read, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(clientId) && isValidClient(incoming());
      allow update: if isSignedIn() && isValidId(clientId) && existing().ownerId == request.auth.uid && incoming().ownerId == request.auth.uid && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'activeJobsCount'])
      );
      allow delete: if isSignedIn() && isValidId(clientId) && existing().ownerId == request.auth.uid;
    }

    match /employee_messages/{messageId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(messageId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(messageId);
      allow delete: if isSignedIn() && isValidId(messageId) && existing().ownerId == request.auth.uid;
    }

    match /employee_documents/{documentId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(documentId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(documentId);
      allow delete: if isSignedIn() && isValidId(documentId) && existing().ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /jobs/{jobId} {
      allow read, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(jobId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(jobId) && existing().ownerId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(jobId) && existing().ownerId == request.auth.uid;
    }

    match /calls/{callId} {
      allow read, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(callId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(callId) && existing().ownerId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(callId) && existing().ownerId == request.auth.uid;
    }
  }
}
