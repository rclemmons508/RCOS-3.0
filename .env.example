# ============================================
# RCOS-3.0 Environment Variables
# ============================================

# === REQUIRED FOR THE WEB APP (Frontend) ===
# These start with VITE_ so they are available in the browser
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIRESTORE_DATABASE_ID=

# Optional Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=

# === SERVER SIDE ONLY (Backend) ===
# These do NOT start with VITE_ and stay secret on the server
GEMINI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
